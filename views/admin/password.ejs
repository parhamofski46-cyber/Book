<%- include('_layout-top') %>

<div class="page-head">
  <div>
    <h1>تغییر رمز عبور</h1>
    <p class="hint">رمز عبور به‌صورت رمزنگاری‌شده ذخیره می‌شود؛ حتی ما هم نمی‌توانیم آن را ببینیم.</p>
  </div>
</div>

<% if (first) { %>
  <div class="alert alert-info">
    ⚠️ شما هنوز از رمز پیش‌فرض استفاده می‌کنید. تا وقتی رمز را عوض نکنید،
    بقیه‌ی بخش‌های پنل باز نمی‌شوند. یک رمز شخصی و قوی انتخاب کنید.
  </div>
<% } %>

<% if (flash === 'changed') { %>
  <div class="alert alert-ok">✅ رمز عبور با موفقیت عوض شد.</div>
<% } %>

<% if (error) { %>
  <div class="alert alert-err"><%= error %></div>
<% } %>

<div class="panel" style="max-width:520px">
  <form method="post" action="/admin/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label for="current">رمز عبور فعلی</label>
      <input type="password" id="current" name="current" required autocomplete="current-password" dir="ltr">
    </div>

    <div class="field">
      <label for="next">رمز عبور جدید</label>
      <p class="desc">حداقل ۸ کاراکتر. ترکیب حروف انگلیسی و عدد امن‌تر است.</p>
      <input type="password" id="next" name="next" required minlength="8"
             autocomplete="new-password" dir="ltr">
    </div>

    <div class="field">
      <label for="confirm">تکرار رمز عبور جدید</label>
      <input type="password" id="confirm" name="confirm" required minlength="8"
             autocomplete="new-password" dir="ltr">
    </div>

    <button class="btn btn-primary btn-lg btn-block" type="submit">تغییر رمز عبور</button>
  </form>
</div>

<div class="panel" style="max-width:520px">
  <h2>رمز را فراموش کرده‌اید؟</h2>
  <p class="hint">
    از روی سرور دستور زیر را اجرا کنید تا رمز جدیدی برایتان ساخته شود:
  </p>
  <pre dir="ltr" style="background:#f6f5f3;padding:.8rem;border-radius:8px;overflow-x:auto;font-size:.85rem">npm run reset-password</pre>
</div>

<%- include('_layout-bottom') %>
