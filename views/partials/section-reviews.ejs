<%
/**
 * نظرات مشتریان.
 * نظرها از دیتابیس خوانده می‌شوند و از پنل مدیریت قابل افزودن/ویرایش‌اند.
 */
const initials = function (name) {
  const clean = String(name || '').replace(/\(نمونه\)/g, '').trim();
  return clean ? clean.charAt(0) : '؟';
};
%>
<% if (reviews && reviews.length) { %>
<section class="section" id="reviews">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow"><%- icon('chat') %> تجربه‌ی مشتری‌های ما</span>
      <div class="section-title"><h2>مشتری‌ها چه می‌گویند</h2></div>
      <p>
        نظر پیمانکارها و اهالی علی‌آباد کتول و گرگان که کارشان را به ما سپرده‌اند.
      </p>
    </div>

    <div class="reviews-head">
      <div class="rating-summary">
        <%- include('stars', { rating: Math.round(reviewSummary.average) }) %>
        <b><%= h.toFaDigits(reviewSummary.average) %></b>
        <span>از <%= h.toFaDigits(reviewSummary.count) %> نظر ثبت‌شده</span>
      </div>
    </div>

    <div class="review-grid reveal">
      <% reviews.forEach(function (r) { %>
        <article class="review-card">
          <%- include('stars', { rating: r.rating }) %>
          <p class="review-text"><%= r.text %></p>
          <div class="review-who">
            <span class="avatar" aria-hidden="true"><%= initials(r.name) %></span>
            <div>
              <b><%= r.name %></b>
              <span>
                <% if (r.job) { %><%= r.job %><% } %>
                <% if (r.job && r.city) { %> · <% } %>
                <% if (r.city) { %>
                  <span class="loc"><%- icon('map') %><%= r.city %></span>
                <% } %>
              </span>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

    <p style="text-align:center;margin-top:1.8rem;color:var(--ink-faint);font-size:.9rem">
      شما هم از ما خرید کرده‌اید؟
      <% const wa = inquiryLink('whatsapp'); if (wa) { %>
        <a href="<%= wa %>" target="_blank" rel="noopener">نظرتان را در واتساپ برایمان بفرستید</a>
      <% } %>
    </p>
  </div>
</section>
<% } %>
