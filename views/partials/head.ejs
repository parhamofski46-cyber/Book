<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : site.description %>">
<meta name="theme-color" content="#a8431a">
<link rel="canonical" href="<%= canonical %>">

<!-- فونت‌ها از قبل بارگذاری می‌شوند تا متن بدون تأخیر نمایش داده شود.
     هر دو وزن لازم‌اند: Regular برای متن، و Bold که بیشترین استفاده را دارد
     (عنوان‌ها، دکمه‌ها، قیمت‌ها). قبلاً فقط Regular preload می‌شد و متن‌های
     درشت با تأخیر و یک پرش کوتاه جایگزین می‌شدند.
     وزن Black عمداً preload نمی‌شود: فقط چند عنوان از آن استفاده می‌کنند و
     اضافه‌کردنش ۳۲ کیلوبایت دیگر را به مسیر بحرانی می‌آورد. -->
<link rel="preload" href="/fonts/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Vazirmatn-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion.css %>">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/favicon.svg">

<!-- اشتراک‌گذاری در شبکه‌های اجتماعی و پیام‌رسان‌ها -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= site.name %>">
<meta property="og:locale" content="fa_IR">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : site.description %>">
<meta property="og:url" content="<%= canonical %>">
<%# اگر صفحه عکس اختصاصی دارد از آن، وگرنه کارت پیش‌فرض سایت %>
<meta property="og:image" content="<%= site.url %><%= (typeof ogImage !== 'undefined' && ogImage) ? ogImage : '/img/og-cover.jpg' %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= site.name %> — <%= site.tagline %>">
<meta name="twitter:card" content="summary_large_image">

<!-- علامت‌گذاری فعال‌بودن جاوااسکریپت؛ انیمیشن ورودِ بخش‌ها فقط در این حالت
     اجرا می‌شود تا اگر اسکریپت لود نشد، محتوا همچنان دیده شود -->
<script nonce="<%= nonce %>">document.documentElement.className += ' js';</script>

<!-- کلمات کلیدی محلی برای موتورهای جست‌وجو -->
<meta name="geo.region" content="IR-37">
<meta name="geo.placename" content="علی‌آباد کتول، گرگان">
<meta name="robots" content="index, follow, max-image-preview:large">
