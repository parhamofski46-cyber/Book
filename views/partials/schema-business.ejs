<%
/**
 * داده‌ی ساختاریافته‌ی Schema.org برای کسب‌وکار محلی.
 * گوگل از این اطلاعات برای نمایش سایت در جست‌وجوهای محلی
 * («آهن فروشی علی‌آباد کتول»، «فرفورژه گرگان») استفاده می‌کند.
 */
const business = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HardwareStore'],
  '@id': site.url + '/#business',
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  url: site.url,
  telephone: '+' + site.phoneIntl,
  image: site.url + '/img/favicon.svg',
  priceRange: '$$',
  currenciesAccepted: 'IRR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    addressCountry: 'IR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  areaServed: site.areaServed.map(function (a) {
    return { '@type': 'City', name: a };
  }),
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
    opens: '08:00',
    closes: '20:00',
  }],
  knowsAbout: ['قوطی', 'پروفیل', 'نبشی', 'رابیتس', 'شاخ گوزنی', 'فنس', 'ایزوگام', 'فرفورژه'],
};
if (site.channels.whatsapp.enabled) {
  business.sameAs = [site.channels.whatsapp.base];
}
if (site.channels.telegram.enabled && site.channels.telegram.base) {
  business.sameAs = (business.sameAs || []).concat([site.channels.telegram.base]);
}
%>
<script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify(business) %></script>
