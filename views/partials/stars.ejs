<%
/**
 * نمایش ستاره‌های امتیاز.
 * ورودی: rating (عدد ۱ تا ۵)
 */
const score = Math.max(0, Math.min(5, Number(locals.rating) || 5));
%>
<span class="stars" role="img" aria-label="امتیاز <%= h.toFaDigits(score) %> از ۵">
  <% for (let i = 1; i <= 5; i++) { %>
    <svg viewBox="0 0 24 24" class="<%= i <= score ? '' : 'off' %>" aria-hidden="true">
      <path d="m12 17.3-6.2 3.7 1.6-7L2 9.2l7.1-.6L12 2l2.9 6.6 7.1.6-5.4 4.8 1.6 7L12 17.3Z"/>
    </svg>
  <% } %>
</span>
