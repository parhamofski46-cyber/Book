<!DOCTYPE html>
<html lang="fa" dir="rtl">
<%
/* اسکیمای سؤالات پرتکرار — گوگل می‌تواند پاسخ‌ها را مستقیم زیر نتیجه‌ی سایت
   نشان بدهد، که هم فضای بیشتری در نتایج می‌گیرد و هم کلیک بیشتری می‌آورد. */
const faq = [
  ['قیمت‌ها در سایت نوشته نشده، چرا؟',
   'قیمت آهن روزانه تغییر می‌کند؛ نوشتن قیمت ثابت در سایت باعث می‌شود اطلاعات غلط به دست شما برسد. به‌جایش، قیمت لحظه‌ای را در واتساپ و تلفن اعلام می‌کنیم.'],
  ['به گرگان هم بار می‌فرستید؟',
   'بله. گرگان، فاضل‌آباد، رامیان، آزادشهر و کردکوی را پوشش می‌دهیم؛ هزینه‌ی حمل بسته به حجم بار محاسبه می‌شود.'],
  ['فرفورژه را خودتان می‌سازید؟',
   'نه — ما گل و طرح‌های فرفورژه را آماده عرضه می‌کنیم، بیش از ۱۰۰۰ مدل برای درب، پنجره و نرده. قطعه را از ما تحویل می‌گیرید و جوشکار خودتان روی کار نصبش می‌کند.'],
  ['ورق گالوانیزه را خودتان تولید می‌کنید؟',
   'بله. ورق شیروانی طرح سفال و طرح گالوانیزه با ضخامت ۰.۵ میلی‌متر تولید خودمان است؛ به همین دلیل قیمت بدون واسطه است.'],
  ['می‌توانم حضوری بیایم و جنس را ببینم؟',
   'حتماً. آدرس: علی‌آباد کتول، خیابان مزرعه، روبه‌روی آهن‌فروشی دیلمی. مخصوصاً برای انتخاب طرح فرفورژه، دیدن حضوری مدل‌ها خیلی راحت‌تر از عکس است.'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(function (f) {
    return {
      '@type': 'Question',
      name: f[0],
      acceptedAnswer: { '@type': 'Answer', text: f[1] },
    };
  }),
};
%>
<head>
  <%- include('../partials/head') %>
  <%- include('../partials/schema-business') %>
  <script type="application/ld+json" nonce="<%= nonce %>"><%- h.jsonLd(faqSchema) %></script>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="main">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a> <span>›</span> <span>تماس با ما</span>
      </nav>

      <section class="section">
        <div class="area-grid">
          <div>
            <div class="section-title"><h1 style="font-size:clamp(1.6rem,1.2rem+1.5vw,2.2rem)">تماس با فولاد ایمان</h1></div>
            <p>
              سریع‌ترین راه گرفتن قیمت روز، پیام واتساپ است؛ لیست خریدتان را بفرستید،
              قیمت و موجودی را همان‌جا می‌نویسیم. برای کارهای سفارشی فرفورژه هم عکس و
              اندازه را بفرستید.
            </p>

            <div class="order-box" style="margin-top:1.4rem">
              <div class="order-actions">
                <% activeChannels().forEach(function (ch) { %>
                  <a class="btn <%= ch.key === 'whatsapp' ? 'btn-wa' : 'btn-tg' %> btn-lg btn-block"
                     href="<%= ch.href %>" target="_blank" rel="noopener">
                    <%- icon(ch.key) %> پیام در <%= ch.label %>
                  </a>
                <% }); %>
                <a class="btn btn-dark btn-lg btn-block" href="<%= site.phoneHref %>">
                  <%- icon('phone') %> تماس: <span dir="ltr"><%= h.toFaDigits(site.phone) %></span>
                </a>
              </div>
            </div>

            <!-- آدرس حضوری، برجسته -->
            <div class="address-card">
              <span class="a-ico"><%- icon('map') %></span>
              <div>
                <b>نشانی مراجعه‌ی حضوری</b>
                <p><%= site.address.city %>، <%= site.address.street %></p>
                <span class="hint-line">انبار، خط تولید ورق و نمایش مدل‌های فرفورژه، همه همین‌جاست.</span>
              </div>
            </div>

            <ul class="spec-list" style="margin-top:1.4rem">
              <li><span>نام کسب‌وکار</span><b><%= site.name %></b></li>
              <li><span>مدیریت</span><b><%= setting('owner_name', 'مدیریت فولاد ایمان') %></b></li>
              <li><span>شماره تماس و واتساپ</span><b dir="ltr"><%= h.toFaDigits(site.phone) %></b></li>
              <li><span>آدرس</span><b><%= site.address.full %></b></li>
              <li><span>ساعات کاری</span><b><%= site.openingHours %></b></li>
              <li><span>منطقه‌ی خدمات</span><b><%= site.areaServed.slice(0, 4).join('، ') %></b></li>
            </ul>
          </div>

          <div class="map-frame">
            <% if (mapEmbed) { %>
              <%- mapEmbed %>
              <div class="map-actions">
                <a class="btn btn-primary" href="<%= mapDirections %>" target="_blank" rel="noopener">
                  <%- icon('map') %> مسیریابی تا فروشگاه
                </a>
                <a class="btn btn-ghost btn-sm" href="<%= mapPlace %>" target="_blank" rel="noopener">
                  باز کردن در گوگل مپ
                </a>
              </div>
            <% } else { %>
              <div class="map-placeholder">
                <%- icon('map', '') %>
                <strong><%= site.address.full %></strong>
                <span style="font-size:.88rem">
                  اگر مسیر را پیدا نکردید، تماس بگیرید — راهنمایی‌تان می‌کنیم.
                </span>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <%- include('../partials/ornament') %>

      <section class="section">
        <div class="section-head">
          <div class="section-title"><h2>سؤال‌های پرتکرار</h2></div>
        </div>
        <ul class="spec-list faq-list">
          <% faq.forEach(function (f) { %>
            <li>
              <b><%= f[0] %></b>
              <span><%= f[1] %></span>
            </li>
          <% }); %>
        </ul>
      </section>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
