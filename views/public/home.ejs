<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <%- include('../partials/head') %>
  <%- include('../partials/schema-business') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="main">

    <!-- ================================================== هیرو -->
    <section class="hero hero-home">
      <div class="wrap hero-grid">
        <div class="hero-inner">
        <span class="eyebrow"><span class="dot"></span> فروش و تولید در علی‌آباد کتول و گرگان</span>
        <h1><%= hero.title %></h1>
        <p class="hero-sub"><%= hero.subtitle %></p>
        <% if (hero.text) { %><p class="hero-text"><%= hero.text %></p><% } %>

        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="/products">
            <%- icon('box') %> مشاهده‌ی محصولات
          </a>
          <% const wa = inquiryLink('whatsapp'); if (wa) { %>
            <a class="btn btn-wa btn-lg" href="<%= wa %>" target="_blank" rel="noopener">
              <%- icon('whatsapp') %> استعلام قیمت در واتساپ
            </a>
          <% } %>
          <a class="btn btn-ghost btn-lg" href="<%= site.phoneHref %>">
            <%- icon('phone') %> <span dir="ltr"><%= h.toFaDigits(site.phone) %></span>
          </a>
        </div>

        <div class="hero-badges">
          <span><%- icon('check') %> قیمت روز و شفاف</span>
          <span><%- icon('truck') %> ارسال به گرگان و شهرهای اطراف</span>
          <span><%- icon('scroll') %> بیش از ۱۰۰۰ مدل فرفورژه‌ی آماده</span>
          <span><%- icon('layers') %> تولیدکننده‌ی ورق گالوانیزه</span>
        </div>
        </div>

        <!-- ترکیب تصویری هیرو: چهار دسته‌ی شاخص، هم تزئین است هم میان‌بر -->
        <div class="hero-art" aria-hidden="true">
          <%
          const heroPicks = ['گل و طرح‌های فرفورژه', 'ورق گالوانیزه', 'قوطی', 'فنس و توری'];
          heroPicks.forEach(function (nm, i) { %>
            <span class="hero-tile hero-tile-<%= i + 1 %>">
              <img src="<%= categoryArtUrl(nm) %>" alt="" width="400" height="300"
                   <%= i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
            </span>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- ================================================== نوار آمار -->
    <%- include('../partials/section-stats') %>

    <!-- ================================================== دسته‌بندی‌ها -->
    <section class="section section-soft" id="categories">
      <div class="wrap">
        <div class="section-head">
          <div class="section-title"><h2>دنبال چه چیزی هستید؟</h2></div>
          <p>روی دسته‌ی موردنظرتان بزنید تا محصولات و موجودی همان دسته را ببینید.</p>
        </div>

        <div class="cat-grid reveal">
          <% gridCategories.forEach(function (cat, i) { %>
            <a class="cat-card <%= cat.is_featured ? 'featured' : '' %>"
               href="/category/<%= encodeURIComponent(cat.slug) %>"
               style="--i:<%= i %>">
              <span class="cat-art">
                <img src="<%= categoryArtUrl(cat.name) %>" alt=""
                     width="400" height="300" loading="lazy" decoding="async">
              </span>
              <span class="cat-meta">
                <b><%= cat.name %></b>
                <small><%= h.toFaDigits(cat.product_count) %> محصول</small>
              </span>
            </a>
          <% }); %>
        </div>
      </div>
    </section>

    <%- include('../partials/ornament') %>

    <!-- ================================================== محصولات تازه -->
    <section class="section" id="products">
      <div class="wrap">
        <div class="section-head head-row">
          <div>
            <div class="section-title"><h2>محصولات پرفروش</h2></div>
            <p>موجودی انبار به‌روز است؛ برای قیمت روز یک پیام واتساپ کافی است.</p>
          </div>
          <a class="btn btn-ghost btn-sm" href="/products">همه‌ی محصولات <%- icon('arrow') %></a>
        </div>

        <div class="product-grid reveal">
          <% latest.forEach(function (product, i) { %>
            <%- include('../partials/product-card', { product: product, eager: i < 4 }) %>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- ================================================== بخش ویژه‌ی فرفورژه -->
    <% if (featuredCategory && forgeProducts.length) { %>
    <section class="section" id="forge">
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">بیش از ۱۰۰۰ مدل، آماده‌ی تحویل</span>
          <div class="section-title"><h2>گل و طرح‌های فرفورژه</h2></div>
          <p>
            برای درب، پنجره و نرده. آنچه اینجا می‌بینید فقط چند نمونه است؛ انبار ما در
            علی‌آباد کتول بیش از هزار مدل دارد. عکس طرح موردنظرتان را بفرستید تا بگوییم موجود است یا نه.
          </p>
        </div>

        <div class="product-grid big reveal">
          <% forgeProducts.forEach(function (product) { %>
            <%- include('../partials/product-card', { product: product }) %>
          <% }); %>
        </div>

        <p style="text-align:center;margin-top:1.6rem">
          <a class="btn btn-primary" href="/forge">دیدن گالری کامل فرفورژه <%- icon('arrow') %></a>
        </p>
      </div>
    </section>
    <% } %>

    <!-- ================================================== معرفی مدیر -->
    <%- include('../partials/section-owner') %>

    <!-- ================================================== نظرات مشتریان -->
    <%- include('../partials/section-reviews') %>

    <!-- ============================== تضمین‌ها و مراحل سفارش -->
    <%- include('../partials/section-trust', { aboutText: aboutText }) %>

    <%- include('../partials/ornament') %>

    <!-- ================================================== منطقه‌ی خدمات -->
    <section class="section section-soft" id="area">
      <div class="wrap">
        <div class="area-grid">
          <div>
            <div class="section-title"><h2>منطقه‌ی خدمات‌رسانی</h2></div>
            <p>
              پایگاه اصلی ما <strong>علی‌آباد کتول</strong> است و بیشترین مشتری‌های ما از
              <strong>گرگان</strong> و شهرهای اطراف هستند. برای پروژه‌های ساختمانی در
              سراسر استان گلستان، بار و کار سفارشی ارسال می‌کنیم.
            </p>
            <ul class="area-list">
              <% site.areaServed.forEach(function (a, i) { %>
                <li class="<%= i < 2 ? 'main' : '' %>"><%= a %></li>
              <% }); %>
            </ul>
            <p style="margin-top:1.4rem">
              <a class="btn btn-primary" href="/contact"><%- icon('map') %> اطلاعات تماس و آدرس</a>
            </p>
          </div>

          <div class="map-frame">
            <% if (mapEmbed) { %>
              <%- mapEmbed %>
            <% } else { %>
              <div class="map-placeholder">
                <%- icon('map', '') %>
                <strong><%= site.address.full %></strong>
                <span style="font-size:.88rem">
                  برای مراجعه‌ی حضوری خوش‌آمدید. اگر مسیر را پیدا نکردید با
                  <a href="<%= site.phoneHref %>" dir="ltr"><%= h.toFaDigits(site.phone) %></a>
                  تماس بگیرید.
                </span>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================== CTA پایانی -->
    <section class="section">
      <div class="wrap">
        <div class="cta-band reveal">
          <div class="ornament"><%- include('../partials/ornament', { variant: 'panel' }) %></div>
          <div>
            <h2>قیمت امروز را بپرسید</h2>
            <p>
              لیست خریدتان را در واتساپ بفرستید؛ قیمت روز، موجودی و زمان تحویل را
              همان‌جا برایتان می‌نویسیم.
            </p>
          </div>
          <div class="cta-actions">
            <% activeChannels().forEach(function (ch) { %>
              <a class="btn <%= ch.key === 'whatsapp' ? 'btn-wa' : 'btn-tg' %> btn-lg"
                 href="<%= ch.href %>" target="_blank" rel="noopener">
                <%- icon(ch.key) %> <%= ch.label %>
              </a>
            <% }); %>
            <a class="btn btn-ghost btn-lg" href="<%= site.phoneHref %>">
              <%- icon('phone') %> تماس تلفنی
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
