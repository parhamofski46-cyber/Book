# ==========================================================================
# تنظیمات محیطی سایت فولاد ایمان
# این فایل را کپی کنید و اسمش را دقیقاً «.env» بگذارید، بعد مقادیر را پر کنید.
#     cp .env.example .env
# فایل .env هرگز نباید در گیت‌هاب یا جای عمومی قرار بگیرد.
# ==========================================================================

# پورتی که سایت روی آن اجرا می‌شود (روی بیشتر هاست‌ها خودکار تنظیم می‌شود)
PORT=3000

# روی سرور واقعی حتماً production باشد (سرعت بیشتر + کوکی امن)
NODE_ENV=production

# آدرس نهایی سایت — بعد از ثبت دامنه اینجا را عوض کنید
SITE_URL=https://fooladiman.ir

# ⚠️ مهم: یک رشته‌ی تصادفی طولانی برای امنیت نشست‌های ورود.
# برای ساختنش این دستور را اجرا کنید:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# کاربر مدیر — فقط در اولین اجرا (وقتی دیتابیس خالی است) استفاده می‌شود.
# اگر اینها را خالی بگذارید، کاربر پیش‌فرض admin / foolad1234 ساخته می‌شود
# و سایت در اولین ورود شما را مجبور به تغییر رمز می‌کند.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# محل ذخیره‌ی دیتابیس (اختیاری — پیش‌فرض پوشه‌ی data/ کنار پروژه)
# DATA_DIR=/var/data/fooladiman
