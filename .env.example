# ---------------------------------------------------------------------------
# Alt Text Autopilot — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# Public HTTPS origin of this app (no trailing slash).
# In development this is your tunnel URL, e.g. https://abc123.trycloudflare.com
APP_URL=https://your-app.example.com

# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/postgres
DATABASE_SSL=require          # "disable" for a local Postgres
DATABASE_POOL_MAX=8

# --- Shopify (Partners -> Apps -> your app -> Client credentials) ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,write_files
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_HANDLE=alt-text-autopilot

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low          # low | medium | high | xhigh | max

# --- Security -------------------------------------------------------------
# 32 bytes, hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Workers --------------------------------------------------------------
WORKER_CONCURRENCY=4
RUN_WORKER_IN_WEB=true

# --- Billing --------------------------------------------------------------
# true creates Shopify test charges — no merchant is ever billed.
BILLING_TEST_MODE=true

LOG_LEVEL=info
