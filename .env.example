# --- Telegram ---
BOT_TOKEN=123456:ABC-your-bot-token
# Your own Telegram user id(s), comma separated. These accounts see the admin panel.
ADMIN_IDS=12345678

# --- Database ---
# Dev:  sqlite+aiosqlite:///./chansub.db
# Prod: postgresql+asyncpg://user:pass@localhost/chansub
DATABASE_URL=sqlite+aiosqlite:///./chansub.db

# --- Platform billing (what channel owners pay YOU) ---
# Manual card-to-card. Amounts get a unique suffix so each payment is
# identifiable in your bank statement without relying on screenshots.
PLATFORM_CARD_NUMBER=6037-9911-1111-1111
PLATFORM_CARD_HOLDER=Your Name
PLATFORM_MONTHLY_PRICE=5000000        # in IRR
PLATFORM_TRIAL_DAYS=14

# --- International billing (owners outside Iran pay you here) ---
# The PayPal address customers send to. This is shown to them, so it is
# public by design -- unlike the secrets in this file.
PLATFORM_PAYPAL_ACCOUNT=parhambamarame@gmail.com
# Optional PayPal.me handle. With it the bot renders a one-tap prefilled
# payment link; without it, customers are shown the address above instead.
PLATFORM_PAYPAL_ME=
PLATFORM_USD_PRICE=1900

# --- Telegram API access ---
# api.telegram.org is filtered inside Iran. If the bot runs on an Iranian
# server, set a proxy here. Leave empty when the host can reach Telegram.
TELEGRAM_PROXY=

# --- Optional: ZarinPal (only used by owners who pick that provider) ---
ZARINPAL_CALLBACK_BASE=https://example.com
