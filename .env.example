# پورت وب‌سرور
PORT=3000

# کلید امضای کوکی نشست — با دستور زیر بساز:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_32_BYTES_HEX

# کلید رمزنگاری اطلاعات ورود اکانت‌ها (AES-256-GCM) — ۶۴ کاراکتر هگز
# اگر این کلید گم شود، اطلاعات ورودِ ذخیره‌شده غیرقابل بازیابی است.
CREDENTIALS_KEY=CHANGE_ME_64_HEX_CHARS

# کارمزد پیش‌فرض سایت روی هر معامله (درصد)
COMMISSION_PERCENT=7

# مدت بازرسی خریدار بعد از تحویل (ساعت)
INSPECTION_HOURS=72

# مسیر فایل دیتابیس
DB_PATH=./data/app.db
